#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_TRIPLE="aarch64-apple-darwin"
# Pulse ships arm64-only, and every Apple Silicon Mac can run macOS 13 or newer.
# macOS 12 left security support in September 2024. This floor has been
# validated only on the current OS; raise it again rather than guess if an
# old-OS report ever appears.
MINIMUM_SYSTEM_VERSION="13.0"
BINARY_NAME="pulse-app"
APP_BUNDLE="$ROOT_DIR/target/release/Pulse.app"
# dock.png carries the Apple icon-grid margin; v06cM3.png is the full-bleed
# in-app brand mark and must not be used for the Dock/icns.
ICON_SOURCE="$ROOT_DIR/crates/pulse-app/assets/app-icon/dock.png"

workspace_version() {
    awk '
        $0 == "[workspace.package]" { in_workspace_package = 1; next }
        /^\[/ { in_workspace_package = 0 }
        in_workspace_package && /^[[:space:]]*version[[:space:]]*=/ {
            value = $0
            sub(/^[^=]*=[[:space:]]*"/, "", value)
            sub(/".*$/, "", value)
            print value
            exit
        }
    ' "$ROOT_DIR/Cargo.toml"
}

VERSION="$(workspace_version)"
if [[ -z "$VERSION" ]]; then
    echo "error: could not read workspace.package.version from Cargo.toml" >&2
    exit 1
fi

if [[ "${1:-}" == "--print-version" ]]; then
    printf '%s\n' "$VERSION"
    exit 0
fi

if [[ $# -ne 0 ]]; then
    echo "usage: $0 [--print-version]" >&2
    exit 1
fi

for variable in SPARKLE_VERSION SPARKLE_URL SPARKLE_SHA256; do
    if [[ -z "${!variable:-}" ]]; then
        echo "error: $variable is required; run make bundle" >&2
        exit 1
    fi
done

if [[ ! -f "$ICON_SOURCE" ]]; then
    echo "error: app icon source not found: $ICON_SOURCE" >&2
    exit 1
fi

ICON_WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pulse-icon.XXXXXX")"
SPARKLE_WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/pulse-sparkle.XXXXXX")"
trap 'rm -rf "$ICON_WORK_DIR" "$SPARKLE_WORK_DIR"' EXIT

SPARKLE_CACHE_DIR="$ROOT_DIR/target/sparkle"
SPARKLE_ARCHIVE="$SPARKLE_CACHE_DIR/Sparkle-$SPARKLE_VERSION.tar.xz"
mkdir -p "$SPARKLE_CACHE_DIR"
if [[ ! -f "$SPARKLE_ARCHIVE" ]] || ! printf '%s  %s\n' "$SPARKLE_SHA256" "$SPARKLE_ARCHIVE" | shasum -a 256 -c - >/dev/null 2>&1; then
    curl --fail --location "$SPARKLE_URL" --output "$SPARKLE_WORK_DIR/Sparkle.tar.xz"
    printf '%s  %s\n' "$SPARKLE_SHA256" "$SPARKLE_WORK_DIR/Sparkle.tar.xz" | shasum -a 256 -c -
    install -m 644 "$SPARKLE_WORK_DIR/Sparkle.tar.xz" "$SPARKLE_ARCHIVE"
fi
tar -xf "$SPARKLE_ARCHIVE" -C "$SPARKLE_WORK_DIR"
test -d "$SPARKLE_WORK_DIR/Sparkle.framework"
mkdir -p "$APP_BUNDLE/Contents/Frameworks"
ditto "$SPARKLE_WORK_DIR/Sparkle.framework" "$APP_BUNDLE/Contents/Frameworks/Sparkle.framework"

export MACOSX_DEPLOYMENT_TARGET="$MINIMUM_SYSTEM_VERSION"
export RUSTFLAGS="${RUSTFLAGS:-} -Lframework=$APP_BUNDLE/Contents/Frameworks -Clink-arg=-Wl,-rpath,@executable_path/../Frameworks"
cargo build \
    --manifest-path "$ROOT_DIR/Cargo.toml" \
    --locked \
    --release \
    --package pulse-app \
    --features updater \
    --target "$TARGET_TRIPLE"

BINARY_PATH="$ROOT_DIR/target/$TARGET_TRIPLE/release/$BINARY_NAME"
if [[ ! -x "$BINARY_PATH" ]]; then
    echo "error: release binary not found: $BINARY_PATH" >&2
    exit 1
fi

if [[ "$(lipo -archs "$BINARY_PATH")" != "arm64" ]]; then
    echo "error: release binary is not arm64: $BINARY_PATH" >&2
    exit 1
fi

if [[ -d "$APP_BUNDLE/Contents/_CodeSignature" ]]; then
    codesign --remove-signature "$APP_BUNDLE"
fi

mkdir -p "$APP_BUNDLE/Contents/MacOS" "$APP_BUNDLE/Contents/Resources"
install -m 755 "$BINARY_PATH" "$APP_BUNDLE/Contents/MacOS/$BINARY_NAME"

ICONSET="$ICON_WORK_DIR/Pulse.iconset"
mkdir -p "$ICONSET"

sips -z 16 16 "$ICON_SOURCE" --out "$ICONSET/icon_16x16.png" >/dev/null
sips -z 32 32 "$ICON_SOURCE" --out "$ICONSET/icon_16x16@2x.png" >/dev/null
sips -z 32 32 "$ICON_SOURCE" --out "$ICONSET/icon_32x32.png" >/dev/null
sips -z 64 64 "$ICON_SOURCE" --out "$ICONSET/icon_32x32@2x.png" >/dev/null
sips -z 128 128 "$ICON_SOURCE" --out "$ICONSET/icon_128x128.png" >/dev/null
sips -z 256 256 "$ICON_SOURCE" --out "$ICONSET/icon_128x128@2x.png" >/dev/null
sips -z 256 256 "$ICON_SOURCE" --out "$ICONSET/icon_256x256.png" >/dev/null
sips -z 512 512 "$ICON_SOURCE" --out "$ICONSET/icon_256x256@2x.png" >/dev/null
sips -z 512 512 "$ICON_SOURCE" --out "$ICONSET/icon_512x512.png" >/dev/null
sips -z 1024 1024 "$ICON_SOURCE" --out "$ICONSET/icon_512x512@2x.png" >/dev/null
iconutil -c icns "$ICONSET" -o "$ICON_WORK_DIR/Pulse.icns"
install -m 644 "$ICON_WORK_DIR/Pulse.icns" "$APP_BUNDLE/Contents/Resources/Pulse.icns"

cat > "$APP_BUNDLE/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$BINARY_NAME</string>
    <key>CFBundleIconFile</key>
    <string>Pulse.icns</string>
    <key>CFBundleIdentifier</key>
    <string>com.wycstudios.pulse</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Pulse</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$VERSION</string>
    <key>CFBundleVersion</key>
    <string>$VERSION</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <key>LSMinimumSystemVersion</key>
    <string>$MINIMUM_SYSTEM_VERSION</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUEnableSystemProfiling</key>
    <false/>
    <key>SUFeedURL</key>
    <string>https://github.com/yicheng47/pulse/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>xRvQCdUz7Gs3VHQiXtGRwv3zZjb3RQVD38mNLFPBB8o=</string>
</dict>
</plist>
EOF

plutil -lint "$APP_BUNDLE/Contents/Info.plist"
printf 'Bundled Pulse %s for arm64 at %s\n' "$VERSION" "$APP_BUNDLE"
